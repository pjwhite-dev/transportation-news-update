    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date()); const values = Object.fromEntries(parts.map(({ type, value }) => [type, value])); const today = `${values.year}-${values.month}-${values.day}`; const state = $getWorkflowStaticData('global'); state.lastSuccessfulPublicationDate = today; state.lastSupplementalPublicationDate = today; return $input.all();"
      },
