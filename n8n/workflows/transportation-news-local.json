      "typeVersion": 1.3,
      "position": [260, 220]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date()); const values = Object.fromEntries(parts.map(({ type, value }) => [type, value])); const today = `${values.year}-${values.month}-${values.day}`; const state = $getWorkflowStaticData('global'); if (state.lastSuccessfulPublicationDate === today) return []; return $input.all();"
      },
      "id": "check-supplemental-daily-guard",
      "name": "Skip if already published today",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 220]
    },
    {
      "parameters": {
        "jsCode": "const sender = String($json.from?.value?.[0]?.address || $json.from || '').toLowerCase(); if (!sender.includes('ette0937@yahoo.com')) throw new Error('Rejected unexpected supplemental sender'); const supplementalText = $json.textHtml || $json.textPlain || $json.snippet || ''; if (!supplementalText) throw new Error('Supplemental email has no usable body'); return [{ json: { supplementalText } }];"
      },
      "id": "encode-email",
      "name": "Encode supplemental email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 220]
    },
    {
      "parameters": {
        "operation": "toText",
        "sourceProperty": "supplementalText",
        "binaryPropertyName": "data",
        "options": { "encoding": "utf8", "fileName": "supplemental-email.txt" }
      },
      "id": "email-to-file",
      "name": "Create private email file",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [920, 220]
    },
    {
