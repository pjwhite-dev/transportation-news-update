      "id": "search-supplemental-gmail",
      "name": "Search read and archived Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [480, 220]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const formatter = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit' }); const today = formatter.format(new Date()); const matches = $input.all().filter(item => { const timestamp = Number(item.json.internalDate); return Number.isFinite(timestamp) && formatter.format(new Date(timestamp)) === today; }); matches.sort((a, b) => Number(b.json.internalDate) - Number(a.json.internalDate)); return matches.slice(0, 1);"
      },
      "id": "select-todays-email",
      "name": "Select today's ETTE email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 220]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "get",
        "messageId": "={{ $json.id }}",
        "simple": false,
        "options": { "downloadAttachments": false }
