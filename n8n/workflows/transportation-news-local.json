      "typeVersion": 1,
      "position": [1140, 220]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().filter(item => String(item.json.stdout || '').trim() === 'READY');"
      },
      "id": "check-supplemental-daily-guard",
      "name": "Skip if already published today",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 220]
    },
    {
      "parameters": {
        "jsCode": "const message = $('Get full ETTE email').first().json; const sender = String(message.from?.value?.[0]?.address || message.from || '').toLowerCase(); if (!sender.includes('ette0937@yahoo.com')) throw new Error('Rejected unexpected supplemental sender'); const supplementalText = message.html || message.textHtml || message.text || message.textPlain || message.snippet || ''; if (!supplementalText) throw new Error('Supplemental email has no usable body'); return [{ json: { supplementalText } }];"
      },
      "id": "encode-email",
      "name": "Encode supplemental email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 220]
    },
